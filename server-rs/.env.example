# ---- server (REV_ prefix) ----
REV_DATABASE_URL=postgres://revklik:revklik@db:5432/revklik
REV_HOST=0.0.0.0
REV_PORT=8787
# comma-separated CORS origins, or "*" for public track endpoints
REV_CORS_ORIGINS=*
REV_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
REV_TRUSTED_PROXY_HOPS=1
REV_ENABLE_JOBS=true

# ---- LLM (OpenAI-compatible) ----
REV_LLM_BASE_URL=https://api.openai.com/v1
REV_LLM_API_KEY=
REV_LLM_MODEL=gpt-4o-mini

# ---- Polar billing ----
REV_POLAR_ACCESS_TOKEN=
REV_POLAR_ORG_ID=
REV_POLAR_WEBHOOK_SECRET=

REV_PUBLIC_ORIGIN=https://app.revklik.com

# ---- Google OAuth ----
REV_GOOGLE_CLIENT_ID=
REV_GOOGLE_CLIENT_SECRET=
REV_GOOGLE_REDIRECT_URI=https://app.revklik.com/api/auth/google/callback

# ---- Marketplaces ----
REV_SHOPEE_PARTNER_ID=
REV_SHOPEE_PARTNER_KEY=
REV_SHOPEE_SHOP_ID=
REV_TOKOPEDIA_CLIENT_ID=
REV_TOKOPEDIA_CLIENT_SECRET=
REV_TOKOPEDIA_FS_ID=

# ---- Cloudflare Email (REST) ----
REV_CF_EMAIL_API_BASE=https://api.cloudflare.com/client/v4
REV_CF_EMAIL_API_TOKEN=
REV_CF_EMAIL_ACCOUNT_ID=
REV_EMAIL_FROM=RevKlik <noreply@revklik.com>

# ---- Pakasir ----
REV_PAKASIR_API_KEY=
