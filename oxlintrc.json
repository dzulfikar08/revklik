{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-console": "off"
	},
	"ignorePatterns": [
		".wrangler",
		"dist",
		"node_modules",
		"**/*.gen.ts",
		"apps/app/public/klikapa*.js",
		"scripts/loadtest",
		"apps/app/ios",
		"apps/app/android"
	]
}
