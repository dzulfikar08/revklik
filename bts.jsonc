	"reproducibleCommand": "bun create better-t-stack@latest revklik-new --frontend tanstack-router native-unistyles --backend hono --runtime workers --database sqlite --orm drizzle --api orpc --auth better-auth --payments polar --addons fumadocs oxlint pwa turborepo ultracite --examples todo --db-setup d1 --web-deploy cloudflare --server-deploy cloudflare --git --package-manager bun --install",
