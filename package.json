{
  "name": "revklik-new",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "@cloudflare/workers-types": "^5.20260728.1",
      "hono": "^4.12.32",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@orpc/tanstack-query": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-form": "^1.33.2",
      "@polar-sh/better-auth": "^1.8.4",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.1",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:generate": "turbo run db:generate -F @revklik-new/db --",
    "deploy": "turbo run deploy -F @revklik-new/infra --",
    "destroy": "turbo run destroy -F @revklik-new/infra --",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@revklik-new/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@revklik-new/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0"
}
