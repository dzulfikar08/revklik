{
	"name": "revklik",
	"version": "0.6.0",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/node": "^26.2.0",
			"@cloudflare/workers-types": "^5.20260728.1",
			"hono": "^4.12.32",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@tanstack/react-query": "^5.101.4",
			"@tanstack/react-form": "^1.33.2",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun --filter @revklik/app dev",
		"build": "bun --filter @revklik/app build",
		"preview": "bun --filter @revklik/app preview",
		"deploy": "bun run typecheck && bun run lint && bun run test && ./scripts/deploy-new-ui.sh",
		"typecheck": "bun --filter @revklik/app typecheck && bun --filter @revklik/shared typecheck && bun --filter @revklik/sdk typecheck && bun --filter @revklik/cli typecheck && bun --filter web typecheck",
		"lint": "oxlint .",
		"test": "bun test",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"build:sdk": "bun --filter @revklik/sdk build",
		"build:cli": "bun --filter @revklik/cli build",
		"mobile:prepare": "bun --filter @revklik/app mobile:prepare",
		"mobile:ios": "bun --filter @revklik/app mobile:ios",
		"mobile:android": "bun --filter @revklik/app mobile:android",
		"dev:web": "turbo run dev -F web --",
		"dev:native": "turbo run dev -F native --",
		"dev:docs": "turbo run dev -F fumadocs --",
		"dev:landing": "turbo run dev -F landing --",
		"typecheck:apps": "turbo run check-types"
	},
	"dependencies": {
		"@revklik/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@revklik/config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "latest",
		"oxlint": "latest",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"ultracite": "7.10.7"
	},
	"overrides": {
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/platform-node-shared": "4.0.0-rc.112",
		"@effect/sql-d1": "4.0.0-rc.112",
		"@effect/sql-sqlite-do": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"effect": "4.0.0-rc.112"
	},
	"packageManager": "bun@1.4.4"
}
