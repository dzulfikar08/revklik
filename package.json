{
	"name": "revklik",
	"version": "0.6.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "bun --filter @revklik/app dev",
		"build": "bun --filter @revklik/app build",
		"preview": "bun --filter @revklik/app preview",
		"deploy": "bun run typecheck && bun run lint && bun run test && ./scripts/deploy-new-ui.sh",
		"typecheck": "bun --filter @revklik/app typecheck && bun --filter @revklik/shared typecheck && bun --filter @revklik/sdk typecheck && bun --filter @revklik/cli typecheck",
		"lint": "oxlint .",
		"test": "bun test",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"build:sdk": "bun --filter @revklik/sdk build",
		"build:cli": "bun --filter @revklik/cli build",
		"mobile:prepare": "bun --filter @revklik/app mobile:prepare",
		"mobile:ios": "bun --filter @revklik/app mobile:ios",
		"mobile:android": "bun --filter @revklik/app mobile:android"
	},
	"devDependencies": {
		"oxfmt": "^0.62.0",
		"oxlint": "^1.78.0"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"workerd",
		"esbuild"
	]
}
