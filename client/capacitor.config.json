{
  "appId": "app.klikapa.mobile",
  "appName": "KlikApa",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["klikapa.app", "*.klikapa.app"]
  },
  "backgroundColor": "#0a0a0a",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0a"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "scheme": "KlikApa",
    "preferredContentMode": "mobile",
    "handleApplicationNotifications": true
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  }
}
