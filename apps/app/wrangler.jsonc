{
	// KEEP the deployed worker name "klikapa" — renaming creates a new Worker
	// and orphans all secrets, the workers.dev URL, and the cron attachments.
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "klikapa",
	"account_id": "b7e6f8457bd39fa37a7eea5249799754",
	"main": "src/worker/index.ts",
	"compatibility_date": "2025-05-25",
	"compatibility_flags": ["nodejs_compat"],
	// Run next to the D1 primary (APAC/SIN) instead of the visitor's colo: Indonesian
	// ISPs often land on SYD/MRS, and every sequential D1 query then pays ~200ms RTT.
	"placement": { "mode": "smart" },
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		// The worker runs for /api/* and for page navigations (so unknown URLs get a real
		// 404, see src/worker/lib/spa-routes.ts). Static files are excluded: klikapa-*.js
		// tracker scripts are high-volume fetches from customer sites and must be served
		// directly by the assets runtime.
		"run_worker_first": [
			"/api/*",
			"/*",
			"!/assets/*",
			"!/klikapa*.js",
			"!/sw.js",
			"!/workbox-*.js",
			"!/registerSW.js",
			"!/manifest.webmanifest",
			"!/*.png",
			"!/*.svg",
			"!/*.ico",
			"!/*.webp",
		],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "klikapa-db",
			"database_id": "06842ad9-7e94-49db-a207-7a58683092d7",
		},
	],
	"send_email": [
		{
			"name": "EMAIL",
		},
	],
	"ai": {
		"binding": "AI",
	},
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "klikapa-backups",
		},
	],
	// Workers Rate Limiting: enforced per Cloudflare location across isolates. The `limit`
	// values must match the per-minute caps in lib/rate-limit.ts and routes/track.ts;
	// without a binding the worker falls back to a per-isolate in-memory limiter.
	"ratelimits": [
		{ "name": "RL_TRACK", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_TRACK_HEAVY", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_API_30", "namespace_id": "7103", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_API_120", "namespace_id": "7104", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_API_300", "namespace_id": "7105", "simple": { "limit": 300, "period": 60 } },
		{ "name": "RL_API_6000", "namespace_id": "7106", "simple": { "limit": 6000, "period": 60 } },
	],
	"triggers": {
		// 03:00 encrypted backup, 03:30 nightly upkeep (retention purge, FX, currency backfill), 18:00 App
		// Store Connect sync, :15 hourly Polar order sync and bot reclassification of recent sessions,
		// every 5 minutes the sale-alert retry + push receipt pass. Each trigger is its own invocation.
		"crons": ["0 3 * * *", "30 3 * * *", "0 18 * * *", "15 * * * *", "*/5 * * * *"],
	},
	"vars": {
		// revklik.com's own site: new accounts are recorded there as a `signup` conversion.
		"REVKLIK_SELF_SITE_ID": "d9701d64-9e78-4b73-9726-e4f41593b843",
	},
}
