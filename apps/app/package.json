{
	"name": "@revklik/app",
	"version": "0.1.0",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "echo \"UI builds moved to revklik-new (scripts/deploy-new-ui.sh)\" && mkdir -p dist/client",
		"build:mobile": "VITE_MOBILE=1 vite build",
		"preview": "vite preview",
		"deploy": "rm -rf dist .wrangler/deploy .wrangler/tmp && vite build && wrangler deploy",
		"typecheck": "tsc --noEmit -p tsconfig.worker.json",
		"cf-typegen": "wrangler types",
		"cap:sync": "cap sync",
		"cap:open:ios": "cap open ios",
		"cap:open:android": "cap open android",
		"mobile:prepare": "bun run build:mobile && bun run cap:sync",
		"mobile:ios": "bun run mobile:prepare && bun run cap:open:ios",
		"mobile:android": "bun run mobile:prepare && bun run cap:open:android"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.1",
		"@capacitor/core": "^8.4.2",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/network": "^8.0.1",
		"@capacitor/preferences": "^8.0.1",
		"@capacitor/push-notifications": "^8.1.2",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.3",
		"@capgo/capacitor-native-biometric": "^8.6.2",
		"@radix-ui/react-slot": "^1.3.0",
		"@radix-ui/react-tooltip": "^1.2.12",
		"@revklik/shared": "workspace:*",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.18",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cobe": "^2.0.1",
		"date-fns": "^4.4.0",
		"hono": "^4.12.30",
		"kysely": "^0.29.3",
		"lucide-react": "^1.25.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-grid-layout": "^2.2.3",
		"react-resizable": "^4.0.2",
		"recharts": "^3.9.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@capacitor/android": "^8.4.2",
		"@capacitor/cli": "^8.4.2",
		"@capacitor/ios": "^8.4.2",
		"@cloudflare/vite-plugin": "^1.52.0",
		"@cloudflare/workers-types": "^5.20260717.1",
		"@tanstack/router-plugin": "^1.168.20",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/react-grid-layout": "^2.1.0",
		"@vitejs/plugin-react": "^6.0.3",
		"bun-types": "^1.4.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.1.5",
		"wrangler": "^4.122.0"
	}
}
