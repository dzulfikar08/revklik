---
// "/" has no content page of its own; send humans and crawlers to the introduction.
const target = new URL("/introduction", Astro.site ?? "https://docs.revklik.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target.href} />
    <meta http-equiv="refresh" content={`0; url=${target.href}`} />
    <title>klikapa docs</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={target.href}>klikapa docs — introduction</a>.
    </p>
  </body>
</html>
