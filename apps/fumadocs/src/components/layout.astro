---
import { ClientRouter } from "astro:transitions";
import { DEFAULT_LOCALE, localePrefix, withTrailingSlash, type Locale } from "@/lib/i18n";

interface Alternate {
  hreflang: string;
  href: string;
}

interface Props {
  /** Page title without the site suffix; omit for pages that only carry the site name. */
  title?: string;
  description?: string;
  /** Served path of this page with its trailing slash, e.g. `/dashboard/overview/` or `/id/`. */
  pathname?: string;
  /** Site-root-relative OG image path; the default only suits the docs home. */
  image?: string;
  /** Language of the page body, set on `<html lang>`. */
  lang?: Locale;
  /** Path the canonical and og:url should point at when it differs from `pathname`. */
  canonicalPath?: string;
  /** Pages that exist in more than one language: one entry per language, plus x-default. */
  alternates?: Alternate[];
  noindex?: boolean;
}

const SITE = Astro.site ?? new URL("https://docs.revklik.com");

const COPY: Record<Locale, { siteName: string; description: string; ogLocale: string }> = {
  en: {
    siteName: "RevKlik docs",
    description:
      "Documentation for RevKlik: privacy-first web and revenue analytics. No third-party cookies, no cross-site tracking.",
    ogLocale: "en_US",
  },
  id: {
    siteName: "Dokumentasi RevKlik",
    description:
      "Dokumentasi RevKlik: analitik web dan pendapatan yang menjaga privasi. Tanpa cookie pihak ketiga, tanpa pelacakan lintas situs.",
    ogLocale: "id_ID",
  },
};

const {
  title,
  lang = DEFAULT_LOCALE,
  pathname = `${localePrefix(lang)}/`,
  canonicalPath,
  alternates = [],
  noindex = false,
} = Astro.props;
const copy = COPY[lang];
const { description = copy.description, image = `${localePrefix(lang)}/og/docs/image.png` } =
  Astro.props;

const canonical = new URL(withTrailingSlash(canonicalPath ?? pathname), SITE).href;
const ogImage = new URL(image, SITE).href;
const hasOwnTitle = Boolean(title) && title !== copy.siteName;
const pageTitle = hasOwnTitle ? `${title} · RevKlik` : copy.siteName;
const ogTitle = hasOwnTitle ? title! : copy.siteName;
const alternateOgLocales = Object.entries(COPY)
  .filter(([locale]) => locale !== lang)
  .map(([, value]) => value.ogLocale);

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: copy.siteName,
  url: new URL(`${localePrefix(lang)}/`, SITE).href,
  inLanguage: lang,
  description: copy.description,
  publisher: {
    "@type": "Organization",
    name: "RevKlik",
    url: "https://revklik.com",
  },
});
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b0e14" />

    <meta property="og:site_name" content={copy.siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.ogLocale} />
    {alternates.length > 0 &&
      alternateOgLocales.map((ogLocale) => (
        <meta property="og:locale:alternate" content={ogLocale} />
      ))}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={websiteJsonLd} />
    <slot name="json-ld" />
    <ClientRouter />
  </head>
  <body
    class="dark flex flex-col min-h-screen"
    transition:persist
    transition:animate="none"
    transition:name="page-layout"
  >
    <slot />
    <script>
      import "@/scripts/enhance";
    </script>
  </body>
</html>
