---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { ArrowLeft } from "lucide-astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
	date.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
---

<Base title={`${post.data.title}: Blog RevKlik`} description={post.data.description}>
	<article class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
		<a href="/blog" class="text-muted hover:text-text inline-flex items-center gap-1.5 text-sm">
			<ArrowLeft size={14} stroke-width={1.75} aria-hidden="true" />
			Semua tulisan
		</a>
		<header class="mt-6">
			<p class="text-muted text-xs">
				<time datetime={post.data.pubDate.toISOString()}>
					{formatDate(post.data.pubDate)}
				</time>
				{post.data.tag && <span class="text-accent ml-2 font-medium">{post.data.tag}</span>}
			</p>
			<h1 class="mt-3 text-3xl leading-tight font-semibold tracking-tight text-balance md:text-4xl">
				{post.data.title}
			</h1>
			<p class="text-muted mt-4 text-[15px] leading-relaxed">{post.data.description}</p>
		</header>
		<div class="prose mt-10">
			<Content />
		</div>
	</article>
</Base>
