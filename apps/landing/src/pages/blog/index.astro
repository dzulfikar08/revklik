---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
	date.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
---

<Base
	title="Blog: RevKlik"
	description="Catatan tentang analytics revenue-first, privasi pengunjung, dan cara menjalankan situs yang benar-benar menghasilkan."
>
	<section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
		<h1 class="text-3xl font-semibold tracking-tight md:text-4xl">Blog</h1>
		<p class="text-muted mt-3 max-w-xl text-[15px] leading-relaxed">
			Catatan tentang analytics revenue-first, privasi pengunjung, dan hal
			hal kecil yang membuat situs Anda menghasilkan.
		</p>

		<div class="divide-line/60 mt-10 divide-y">
			{posts.map((post) => (
				<article class="py-6">
					<p class="text-muted text-xs">
						<time datetime={post.data.pubDate.toISOString()}>
							{formatDate(post.data.pubDate)}
						</time>
						{post.data.tag && (
							<span class="text-accent ml-2 font-medium">{post.data.tag}</span>
						)}
					</p>
					<h2 class="mt-2 text-lg font-semibold tracking-tight">
						<a href={`/blog/${post.id}`} class="hover:text-accent">
							{post.data.title}
						</a>
					</h2>
					<p class="text-muted mt-2 text-sm leading-relaxed">{post.data.description}</p>
				</article>
			))}
		</div>
	</section>
</Base>
