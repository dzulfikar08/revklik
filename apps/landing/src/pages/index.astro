---
import { Plus } from "lucide-astro";
import Base from "../layouts/Base.astro";

const APP_URL = "https://app.revklik.com";
const DOCS_URL = "https://docs.revklik.com";

const snippet = `<script src="https://app.revklik.com/klikapa.js"></script>
<script>
  window.klikapa_site_id = "ID-SITUS-ANDA";
  window.klikapa_endpoint = "https://app.revklik.com/api/track";
</script>`;

const payments = [
	"Midtrans",
	"Xendit",
	"Stripe",
	"Lemon Squeezy",
	"Shopee",
	"Tokopedia",
	"Polar",
	"Google Search Console",
];

const features = [
	{
		title: "Perjalanan tiap pengunjung",
		body: "Setiap pengunjung dapat identitas samaran yang bisa dibaca, timeline langkah demi langkah, plus tag dan catatan untuk tim Anda.",
	},
	{
		title: "Funnel yang terbentuk sendiri",
		body: "Tandai bagian halaman dengan data-section dan funnel scroll muncul otomatis. Tidak perlu membangun funnel manual.",
	},
	{
		title: "Realtime",
		body: "Jumlah pengunjung online dan aliran event masuk langsung ke dashboard, pas saat kampanye Anda sedang berjalan.",
	},
	{
		title: "Data Anda, milik Anda",
		body: "Ekspor CSV dari dashboard untuk rentang dan filter mana pun, atau pakai API token dengan scope analytics:export.",
	},
];

const plans = [
	{
		name: "Micro",
		price: "Gratis",
		period: null,
		note: "Untuk mencoba tanpa risiko.",
		features: [
			"1 situs",
			"10K event per bulan",
			"Skrip di bawah 1KB",
			"Retensi 7 hari",
		],
		highlight: false,
	},
	{
		name: "Starter",
		price: "Rp 64.000",
		period: "/bulan",
		note: "Paling pas untuk situs yang mulai serius jualan.",
		features: [
			"3 situs",
			"100K event per bulan",
			"Retensi 30 hari",
			"Funnel konversi",
			"Atribusi revenue",
			"Dashboard realtime",
		],
		highlight: true,
	},
	{
		name: "Growth",
		price: "Rp 192.000",
		period: "/bulan",
		note: "Untuk tim yang butuh semua data dan kepercayaan diri.",
		features: [
			"10 situs",
			"500K event per bulan",
			"Retensi 90 hari",
			"AI insights",
			"Heatmap",
			"Session replay",
			"Semua integrasi",
			"Prioritas support",
			"Anggota tim",
		],
		highlight: false,
	},
];

const baseFeatures = "Semua paket sudah termasuk: tanpa cookie, profil pengunjung, pelacakan UTM, ekspor CSV.";

const faqs = [
	{
		q: "Apakah RevKlik ramah privasi?",
		a: "Ya. Pengunjung tampil sebagai nama samaran deterministik (nama dan avatar, bukan identitas mentah), parameter event yang sensitif otomatis disamarkan, dan Anda bisa mengecualikan perangkat sendiri serta membersihkan jejak kunjungan Anda dari dashboard.",
	},
	{
		q: "Data apa saja yang dikumpulkan skrip tracking?",
		a: "Pageview, klik, kedalaman scroll, bagian halaman yang dibaca pengunjung, custom event yang Anda picu, dan konversi yang bisa membawa nilai revenue.",
	},
	{
		q: "Dari mana data revenue berasal?",
		a: "Tiga sumber: konversi dengan nilai revenue, webhook payment provider (Midtrans, Xendit, Stripe, Lemon Squeezy), dan pesanan marketplace (Shopee, Tokopedia). Anda juga bisa mengimpor order historis dari Polar.",
	},
	{
		q: "Bagaimana cara bayar dari Indonesia?",
		a: "Dengan QRIS (RevKlik membuka halaman pembayaran QRIS lalu memverifikasi pembayaran Anda) atau kartu lewat hosted checkout. Harga dalam rupiah, per bulan, batalkan kapan saja.",
	},
	{
		q: "Apakah saya bisa mengeluarkan data saya?",
		a: "Bisa. Tombol ekspor di dashboard mengunduh event mentah untuk rentang dan filter aktif sebagai CSV. API token dengan scope analytics:export memungkinkan ekspor terprogram.",
	},
	{
		q: "Bagaimana cara berhenti berlangganan?",
		a: "Buka Billing, pilih Cancel subscription, lalu konfirmasi. Paket tetap aktif sampai akhir periode dan tidak diperpanjang otomatis.",
	},
];
---

<Base
	title="RevKlik: analytics web dan revenue yang ramah privasi"
	description="Lihat siapa yang berkunjung, apa yang mereka baca, dan kapan kunjungan berubah jadi uang masuk. Tanpa cookie, skrip di bawah 1KB, harga dalam rupiah, bayar dengan QRIS atau kartu."
>
	<!-- Hero -->
	<section class="mx-auto max-w-6xl px-4 pt-16 pb-20 md:px-6 md:pt-24 md:pb-28">
		<div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]">
			<div class="min-w-0">
				<h1 class="text-4xl leading-[1.1] font-semibold tracking-tight text-balance md:text-5xl">
					Analytics yang menghitung rupiah, bukan cuma kunjungan.
				</h1>
				<p class="text-muted mt-5 max-w-xl text-[15px] leading-relaxed md:text-base">
					RevKlik mencatat siapa yang berkunjung, apa yang mereka baca, dan
					kapan kunjungan berubah jadi uang masuk, dari Midtrans sampai
					Shopee, dalam satu dashboard. Tanpa cookie.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-4">
					<a
						href={`${APP_URL}/login`}
						class="btn bg-accent text-accent-ink hover:bg-accent/90 rounded-btn px-5 py-2.5 text-sm font-medium"
					>
						Mulai gratis
					</a>
					<a
						href={DOCS_URL}
						target="_blank"
						rel="noopener"
						class="text-muted hover:text-text text-sm underline decoration-line underline-offset-4"
					>
						Baca dokumentasi
					</a>
				</div>
				<p class="text-muted mt-4 text-xs">
					Gratis 7 hari, tanpa kartu. Lanjut dengan paket Micro gratis.
				</p>
			</div>

			<!-- The product's real first touchpoint: the per-site snippet. -->
			<figure
				class="bg-surface rounded-card shadow-card min-w-0 p-2"
				aria-label="Contoh snippet pelacakan RevKlik"
			>
				<div class="bg-bg rounded-inner border-line/70 border p-4">
					<div class="flex items-center justify-between gap-3">
						<p class="text-[13px] font-medium">Snippet situs Anda</p>
						<span class="text-muted font-mono text-[11px]">situsanda.com</span>
					</div>
					<pre
						class="mt-3 overflow-x-auto rounded-[8px] bg-surface-2 p-3 font-mono text-[11px] leading-relaxed"><code>{snippet}</code></pre>
					<p class="text-muted mt-3 text-xs leading-relaxed">
						Skrip asli yang dibuat otomatis per situs. Tempel di bagian
						<code class="font-mono text-[11px]">&lt;head&gt;</code>, statistik
						mengalir sejak kunjungan pertama.
					</p>
				</div>
				<figcaption class="text-muted flex items-center justify-between px-2 py-2.5 text-[11px]">
					<span>Di bawah 1KB, tanpa cookie</span>
					<span class="bg-accent-soft text-accent rounded-full px-2 py-0.5 font-medium">Live dalam hitungan detik</span>
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- Live dashboard: RevKlik's own real data, embeds the public /public/:token page. -->
	<section class="border-line/60 border-t">
		<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<h2 class="max-w-xl text-2xl font-semibold tracking-tight text-balance md:text-3xl">
					Data nyata, dari dashboard kami sendiri.
				</h2>
				<p class="text-muted text-sm">
					Ini dashboard publik revklik.com, diukur dengan RevKlik juga.
				</p>
			</div>
			<div class="bg-surface rounded-card shadow-card mt-8 p-2">
				<iframe
					src="https://app.revklik.com/public/b719ba64-478e-49c4-819f-06dd0376a6ce?embed=1"
					title="Dashboard live RevKlik dengan data nyata dari situs revklik.com"
					loading="lazy"
					class="bg-bg h-[600px] w-full rounded-inner border-0"
				></iframe>
			</div>
		</div>
	</section>

	<!-- Fitur -->
	<section id="fitur" class="border-line/60 border-t">
		<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
			<!-- Flagship: revenue, the reason this product exists. -->
			<div class="bg-surface rounded-card shadow-card p-6 md:p-8">
				<p class="text-accent text-xs font-medium tracking-wide uppercase">
					Revenue analytics
				</p>
				<h2 class="mt-3 max-w-2xl text-2xl font-semibold tracking-tight text-balance md:text-3xl">
					Dari klik ke pembayaran, satu garis cerita.
				</h2>
				<p class="text-muted mt-4 max-w-2xl text-[15px] leading-relaxed">
					Konversi bisa membawa nilai uang. Webhook payment provider, pesanan
					marketplace, dan order langganan mengalir ke panel revenue yang sama.
					Pecah per sumber, per halaman, per negara, dan lihat channel mana
					yang benar-benar mendatangkan pembeli, bukan cuma pengunjung.
				</p>
			</div>

			<!-- Supporting features: plain rows, hierarchy by treatment, not uniform cards. -->
			<div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
				{features.map((feature) => (
					<div class="border-line/60 border-t pt-6">
						<h3 class="text-[15px] font-semibold">{feature.title}</h3>
						<p class="text-muted mt-2 text-sm leading-relaxed">{feature.body}</p>
					</div>
				))}
			</div>

			<!-- Integrations: real names, text only, no fabricated logos. -->
			<div class="mt-14">
				<h3 class="text-[15px] font-semibold">Terhubung ke uang Anda di mana pun berada</h3>
				<ul class="mt-5 flex flex-wrap gap-2.5" role="list">
					{payments.map((name) => (
						<li class="bg-surface-2 border-line/60 text-muted rounded-full border px-3.5 py-1.5 text-[13px]">
							{name}
						</li>
					))}
				</ul>
				<p class="text-muted mt-4 max-w-2xl text-[13px] leading-relaxed">
					Hubungkan lewat webhook atau OAuth, data revenue langsung mengisi
					panel yang sama dengan data kunjungan Anda.
				</p>
			</div>
		</div>
	</section>

	<!-- Privasi -->
	<section class="border-line/60 border-t">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:px-6 md:py-24 lg:grid-cols-2">
			<div>
				<h2 class="max-w-md text-2xl font-semibold tracking-tight text-balance md:text-3xl">
					Pengunjung tetap manusia, bukan baris data.
				</h2>
				<p class="text-muted mt-4 max-w-lg text-[15px] leading-relaxed">
					Identitas pengunjung tampil sebagai nama samaran yang bisa dibaca,
					bukan jejak digital. Nilai formulir yang sensitif otomatis
					disamarkan. Kecualikan perangkat Anda sendiri dari tracking, dan
					bersihkan jejak kunjungan Anda kapan saja dengan satu klik.
				</p>
			</div>
			<div class="bg-surface rounded-card shadow-card flex flex-wrap items-center gap-3 p-6" role="img" aria-label="Contoh identitas samaran pengunjung dengan tag">
				<span class="bg-raised rounded-full py-1.5 pr-3.5 pl-1.5">
					<span class="bg-accent text-accent-ink mr-2 inline-flex size-6 items-center justify-center rounded-full text-[11px] font-semibold">kq</span>
					<span class="text-[13px] font-medium">kobalt quokka</span>
				</span>
				<span class="border-line/60 text-muted rounded-full border px-3 py-1 text-xs">tag: pembeli</span>
				<span class="border-line/60 text-muted rounded-full border px-3 py-1 text-xs">catatan: dari iklan IG</span>
			</div>
		</div>
	</section>

	<!-- Harga -->
	<section id="harga" class="border-line/60 border-t">
		<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
			<div class="max-w-2xl">
				<h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
					Harga dalam rupiah, tanpa drama.
				</h2>
				<p class="text-muted mt-3 text-[15px]">
					Bulanan, batalkan kapan saja. Bayar dengan QRIS atau kartu.
				</p>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-3">
				{plans.map((plan) => (
					<div
						class:list={[
							"bg-surface rounded-card p-6",
							plan.highlight
								? "shadow-card ring-accent/60 ring-1"
								: "border-line/60 shadow-card border",
						]}
					>
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="text-[15px] font-semibold">{plan.name}</h3>
							{plan.highlight && (
								<span class="bg-accent-soft text-accent rounded-full px-2.5 py-0.5 text-[11px] font-medium">
									Paling laris
								</span>
							)}
						</div>
						<p class="mt-4">
							<span class="text-3xl font-semibold tracking-tight">{plan.price}</span>
							{plan.period && <span class="text-muted text-sm"> {plan.period}</span>}
						</p>
						<p class="text-muted mt-2 text-[13px]">{plan.note}</p>
						<ul class="mt-5 space-y-2.5" role="list">
							{plan.features.map((feature) => (
								<li class="text-muted flex items-start gap-2.5 text-[13px]">
									<span class="bg-accent/80 mt-1.5 size-1.5 shrink-0 rounded-full" aria-hidden="true" />
									{feature}
								</li>
							))}
						</ul>
						<a
							href={`${APP_URL}/login`}
							class:list={[
								"btn mt-6 block rounded-btn px-4 py-2 text-center text-sm font-medium",
								plan.highlight
									? "bg-accent text-accent-ink hover:bg-accent/90"
									: "border-line text-text hover:bg-surface-2 border",
							]}
						>
							{plan.price === "Gratis" ? "Mulai" : "Pilih paket"}
						</a>
					</div>
				))}
			</div>
			<p class="text-muted mt-6 text-xs">{baseFeatures}</p>
		</div>
	</section>

	<!-- FAQ -->
	<section id="faq" class="border-line/60 border-t">
		<div class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
			<h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Pertanyaan yang sering muncul</h2>
			<div class="mt-8 divide-line/60 divide-y">
				{faqs.map((item) => (
					<details class="group py-4">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-medium">
							{item.q}
							<Plus
								class="text-muted shrink-0 transition-transform duration-150 group-open:rotate-45"
								size={14}
								stroke-width={1.75}
								aria-hidden="true"
							/>
						</summary>
						<p class="text-muted mt-3 pr-8 text-sm leading-relaxed">{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="border-line/60 border-t">
		<div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
			<div class="bg-surface rounded-card shadow-card px-6 py-10 text-center md:py-14">
				<h2 class="mx-auto max-w-xl text-2xl font-semibold tracking-tight text-balance md:text-3xl">
					Pasang hari ini, baca datanya besok.
				</h2>
				<p class="text-muted mx-auto mt-3 max-w-lg text-[15px]">
					Tiga langkah: daftar, tambah situs, tempel snippet. Statistik mulai
					mengalir pada kunjungan pertama.
				</p>
				<a
					href={`${APP_URL}/login`}
					class="btn bg-accent text-accent-ink hover:bg-accent/90 mt-7 inline-block rounded-btn px-6 py-2.5 text-sm font-medium"
				>
					Mulai gratis
				</a>
			</div>
		</div>
	</section>
</Base>
