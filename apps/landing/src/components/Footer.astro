---
const year = new Date().getFullYear();

const groups = [
	{
		title: "Produk",
		links: [
			{ href: "/#fitur", label: "Fitur" },
			{ href: "/#harga", label: "Harga" },
			{ href: "/#faq", label: "FAQ" },
		],
	},
	{
		title: "Sumber",
		links: [
			{ href: "/blog", label: "Blog" },
			{ href: "https://docs.revklik.com", label: "Dokumentasi", external: true },
			{ href: "https://app.revklik.com/login", label: "Masuk", external: true },
		],
	},
];
---

<footer class="border-line border-t">
	<div class="mx-auto max-w-6xl px-4 py-10 md:px-6">
		<div class="flex flex-col gap-8 md:flex-row md:justify-between">
			<div class="max-w-xs">
				<div class="flex items-center gap-2">
					<img src="/revklik.webp" alt="" width="24" height="24" class="rounded-md" />
					<span class="text-sm font-semibold tracking-tight">RevKlik</span>
				</div>
				<p class="text-muted mt-3 text-[13px] leading-relaxed">
					Analytics web dan revenue yang ramah privasi. Kunjungan, perjalanan
					pengunjung, dan uang masuk dalam satu dashboard.
				</p>
			</div>
			<div class="flex gap-14">
				{groups.map((group) => (
					<div>
						<h2 class="text-text text-[13px] font-semibold">{group.title}</h2>
						<ul class="mt-3 space-y-2.5">
							{group.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-muted hover:text-text text-[13px]"
										target={link.external ? "_blank" : undefined}
										rel={link.external ? "noopener" : undefined}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
		<p class="text-muted mt-10 text-xs">&copy; {year} RevKlik</p>
	</div>
</footer>
