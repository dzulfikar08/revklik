---
import { C } from '../data/copy';
---
<section class="faq" id="faq" data-section="faq">
  <div class="wrap">
    <div class="section-head">
      <h2>{C.faq_title}</h2>
    </div>
    <div class="faq-grid">
      <div class="faq-list">
        {C.faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <aside class="faq-aside">
        <p>{C.faq_aside}</p>
        <a class="link-plain" href="/support.html">{C.faq_aside_cta}</a>
      </aside>
    </div>
  </div>
</section>
