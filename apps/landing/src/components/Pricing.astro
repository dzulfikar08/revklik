---
import type { Copy } from '../data/copy';
import { appLink, getPlans, registerUrl, SUPPORT_EMAIL } from '../data/site';
interface Props {
	c: Copy;
}
const { c } = Astro.props;
const plans = getPlans(c);
const currency = (label: string) => (label.startsWith('Rp') ? 'Rp' : '$');
const amount = (label: string) => label.replace(/^(Rp ?|\$)/, '');
---
<section class="pricing" id="pricing" data-section="pricing">
  <div class="wrap">
    <div class="section-head">
      <h2>{c.price_title}</h2>
      <p>{c.price_desc}</p>
    </div>
    <ol class="trial-line" aria-label={c.price_title}>
      {c.price_timeline.map((t) => (
        <li><strong>{t.when}</strong><span>{t.what}</span></li>
      ))}
    </ol>
    <div class="plans">
      {plans.map((plan) => (
        <article class={`plan${plan.highlight ? ' plan-highlight' : ''}`}>
          <div class="plan-id">
            <h3>{plan.name}</h3>
            <p>{plan.desc}</p>
            {plan.highlight && <p class="plan-note">{c.price_highlight}</p>}
          </div>
          <div>
            <p class="plan-price"><span class="cur">{currency(plan.label)}</span><span class="amt">{amount(plan.label)}</span><span class="per">{c.price_per}</span></p>
            <p class="plan-alt">{plan.altLabel}</p>
          </div>
          <ul class="plan-feats">
            {plan.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href={appLink(registerUrl(plan), c.lang)} class={`btn plan-cta ${plan.highlight ? 'btn-primary' : 'btn-ghost'}`} data-cta data-revklik-goal="register_click" data-revklik-goal-plan={plan.name}>{c.plan_cta.replace('{plan}', plan.name)}</a>
        </article>
      ))}
    </div>
    <p class="pricing-note">{c.price_note} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
  </div>
</section>
