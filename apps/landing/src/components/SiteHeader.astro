---
import { C } from '../data/copy';
import { LOGIN_URL, REGISTER_URL } from '../data/site';
import BrandMark from './BrandMark.astro';
---
<header class="site-nav">
  <nav class="wrap nav-bar" aria-label={C.nav_label}>
    <a href="/" class="brand"><BrandMark width={34} /><span>Rev<b>Klik</b></span></a>
    <div id="site-menu" class="nav-menu">
      <a class="nav-link" href="#features">{C.nav_features}</a>
      <a class="nav-link" href="#cara-pasang">{C.nav_how}</a>
      <a class="nav-link" href="#pricing">{C.nav_pricing}</a>
      <a class="nav-link" href="#faq">{C.nav_faq}</a>
      <a class="nav-link" href="/blog.html">{C.nav_blog}</a>
      <a href={REGISTER_URL} class="btn btn-primary menu-cta" data-cta data-revklik-goal="register_click" data-revklik-goal-location="nav_menu">{C.nav_cta}</a>
    </div>
    <a href={LOGIN_URL} class="nav-link nav-login">{C.nav_login}</a>
    <a href={REGISTER_URL} class="btn btn-primary btn-sm nav-cta" data-cta data-revklik-goal="register_click" data-revklik-goal-location="nav">{C.nav_cta}</a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu">{C.nav_menu}</button>
  </nav>
</header>
