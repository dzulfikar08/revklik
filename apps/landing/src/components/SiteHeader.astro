---
import type { Copy, Locale } from '../data/copy';
import { appLink, docsUrl, LOGIN_URL, REGISTER_URL } from '../data/site';
import { type Alternates, localePath } from '../data/seo';
import BrandMark from './BrandMark.astro';

interface Props {
	c: Copy;
	locale: Locale;
	home?: boolean;
	current?: 'blog' | 'docs';
	alternates?: Alternates;
}
const { c, locale, home = false, current, alternates } = Astro.props;
const homePath = localePath(locale, '/');
// Section anchors only exist on the home page; elsewhere they go back to it.
const anchor = (id: string) => (home ? `#${id}` : `${homePath}#${id}`);
const blog = localePath(locale, '/blog');
const options = [
	{ value: 'id', label: 'ID', name: c.locale_id_name, href: alternates?.id ?? '/' },
	{ value: 'en', label: 'EN', name: c.locale_en_name, href: alternates?.en ?? '/en/' },
] as const;
---
<header class="site-nav">
  <nav class="wrap nav-bar" aria-label={c.nav_label}>
    <a href={homePath} class="brand" aria-label={c.home_label}><BrandMark width={34} /><span>Rev<b>Klik</b></span></a>
    <div id="site-menu" class="nav-menu">
      <a class="nav-link" href={anchor('features')}>{c.nav_features}</a>
      <a class="nav-link" href={anchor('cara-pasang')}>{c.nav_how}</a>
      <a class="nav-link" href={anchor('pricing')}>{c.nav_pricing}</a>
      <a class="nav-link" href={anchor('faq')}>{c.nav_faq}</a>
      <a class="nav-link" href={blog} aria-current={current === 'blog' ? 'page' : undefined}>{c.nav_blog}</a>
      <a class="nav-link" href={docsUrl(locale)}>{c.f_docs}</a>
      <div class="lang-switch" role="group" aria-label={c.locale_label}>
        {options.map((o) => (
          <a
            href={o.href}
            class="lang-opt"
            lang={o.value}
            hreflang={o.value}
            aria-label={o.name}
            aria-current={o.value === locale ? 'true' : undefined}
            data-locale-link={o.value}
          >{o.label}</a>
        ))}
      </div>
      <a href={appLink(REGISTER_URL, c.lang)} class="btn btn-primary menu-cta" data-cta data-revklik-goal="register_click" data-revklik-goal-location="nav_menu">{c.nav_cta}</a>
    </div>
    <a href={appLink(LOGIN_URL, c.lang)} class="nav-link nav-login">{c.nav_login}</a>
    <a href={appLink(REGISTER_URL, c.lang)} class="btn btn-primary btn-sm nav-cta" data-cta data-revklik-goal="register_click" data-revklik-goal-location="nav">{c.nav_cta}</a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-menu">{c.nav_menu}</button>
  </nav>
</header>
