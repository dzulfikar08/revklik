---
import { Menu, X } from "lucide-astro";
const APP_URL = "https://app.revklik.com";
const DOCS_URL = "https://docs.revklik.com";

const links = [
	{ href: "/#fitur", label: "Fitur" },
	{ href: "/#harga", label: "Harga" },
	{ href: "/#faq", label: "FAQ" },
	{ href: "/blog", label: "Blog" },
	{ href: DOCS_URL, label: "Dokumentasi", external: true },
];
---

<header class="border-line bg-bg/95 sticky top-0 z-50 border-b">
	<div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 md:px-6">
		<a href="/" class="flex items-center gap-2" aria-label="RevKlik, kembali ke beranda">
			<img src="/revklik.webp" alt="" width="28" height="28" class="rounded-md" />
			<span class="text-[15px] font-semibold tracking-tight">RevKlik</span>
		</a>

		<nav class="hidden items-center gap-6 md:flex" aria-label="Navigasi utama">
			{links.map((link) => (
				<a
					href={link.href}
					class="text-muted hover:text-text text-[13px]"
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noopener" : undefined}
				>
					{link.label}
				</a>
			))}
			<a
				href={`${APP_URL}/login`}
				class="btn bg-accent text-accent-ink hover:bg-accent/90 rounded-btn px-3.5 py-1.5 text-[13px] font-medium"
			>
				Masuk
			</a>
		</nav>

		<button
			id="menu-button"
			type="button"
			class="border-line text-text hover:bg-surface-2 rounded-btn border p-2 md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Buka menu"
		>
			<span class="icon-menu block"><Menu size={16} stroke-width={1.75} aria-hidden="true" /></span>
			<span class="icon-close hidden"><X size={16} stroke-width={1.75} aria-hidden="true" /></span>
		</button>
	</div>

	<nav
		id="mobile-nav"
		class="border-line border-t px-4 py-3 md:hidden"
		hidden
		aria-label="Navigasi seluler"
	>
		{links.map((link) => (
			<a
				href={link.href}
				class="text-muted hover:text-text border-line/60 border-b py-3 text-sm last:border-0"
				target={link.external ? "_blank" : undefined}
				rel={link.external ? "noopener" : undefined}
			>
				{link.label}
			</a>
		))}
		<a
			href={`${APP_URL}/login`}
			class="btn bg-accent text-accent-ink mt-3 rounded-btn px-3.5 py-2.5 text-center text-sm font-medium"
		>
			Masuk
		</a>
	</nav>
</header>

<style>
	/* Icon follows the real aria-expanded state; no extra JS branch needed. */
	#menu-button :global(.icon-close) {
		display: none;
	}
	#menu-button[aria-expanded="true"] :global(.icon-menu) {
		display: none;
	}
	#menu-button[aria-expanded="true"] :global(.icon-close) {
		display: block;
	}
</style>

<script>
	const button = document.getElementById("menu-button");
	const nav = document.getElementById("mobile-nav");

	function setOpen(open: boolean) {
		if (!(button instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
		button.setAttribute("aria-expanded", String(open));
		button.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
		nav.toggleAttribute("hidden", !open);
	}

	button?.addEventListener("click", () => {
		if (!(nav instanceof HTMLElement)) return;
		setOpen(nav.hasAttribute("hidden"));
	});

	document.addEventListener("keydown", (event) => {
		if (
			event.key === "Escape" &&
			nav instanceof HTMLElement &&
			!nav.hasAttribute("hidden")
		) {
			setOpen(false);
			button?.focus();
		}
	});

	// Close the panel after navigating; anchors leave it open otherwise.
	nav?.addEventListener("click", (event) => {
		if (event.target instanceof HTMLAnchorElement) setOpen(false);
	});
</script>
