---
import { C } from '../data/copy';
import { REGISTER_URL } from '../data/site';
const [plain, money] = C.hero_title;
---
<section class="hero" data-section="hero">
  <div class="wrap">
    <div class="hero-copy">
      <h1>{plain}<span class="hl">{money}</span></h1>
      <p class="lede">{C.hero_sub}</p>
      <div class="hero-actions">
        <a href={REGISTER_URL} class="btn btn-primary" data-cta data-revklik-goal="register_click" data-revklik-goal-location="hero">{C.hero_cta1}</a>
        <a href="#pricing" class="btn btn-ghost" data-cta data-revklik-goal="pricing_click" data-revklik-goal-location="hero">{C.hero_cta2}</a>
      </div>
      <p class="fine">{C.hero_note}</p>
    </div>
  </div>
</section>
