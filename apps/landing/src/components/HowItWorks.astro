---
import { C } from '../data/copy';
import { TRACKER_URL } from '../data/site';
const snippet = `<script defer data-site-id="your-site-id" src="${TRACKER_URL}"></scr` + `ipt>`;
---
<section class="how" id="cara-pasang" data-section="how-it-works">
  <div class="wrap">
    <div class="section-head">
      <h2>{C.how_title}</h2>
      <p>{C.how_desc}</p>
    </div>
    <div class="how-grid">
      <ol class="steps">
        {C.steps.map((s) => (
          <li class="step">
            <div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="step-meta">{s.meta}</span>
            </div>
          </li>
        ))}
      </ol>
      <div class="snippet">
        <div class="snippet-bar">
          <span>{C.code_label}</span>
          <button type="button" class="btn btn-ghost btn-sm" data-copy-snippet={snippet} data-copied={C.code_copied} data-failed={C.code_failed}>{C.code_copy}</button>
        </div>
        <pre class="snippet-code"><code>&lt;script defer data-site-id="<span class="ph">your-site-id</span>" src="{TRACKER_URL}"&gt;&lt;/script&gt;</code></pre>
        <p class="snippet-status" role="status" data-copy-status></p>
        <a class="link-plain" href="https://docs.revklik.com">{C.code_docs}</a>
      </div>
    </div>
  </div>
</section>
