---
import type { Copy } from '../data/copy';
import { localePath } from '../data/seo';
interface Props {
	c: Copy;
}
const { c } = Astro.props;
const lead = c.feat_lead;
const locale = c.lang === 'en' ? 'en' : 'id';
const internal = (href: string) => (href.startsWith('/') ? localePath(locale, href) : href);
---
<section class="features" id="features" data-section="features">
  <div class="wrap split">
    <div class="section-head split-head">
      <h2>{c.feat_title}</h2>
      <p>{c.feat_desc}</p>
    </div>
    <div class="split-body">
      <article class="feature-lead">
        <h3>{lead.title}</h3>
        <p>{lead.desc}</p>
        <div class="gateways">
          <span id="gateways-label">{lead.gateways_label}</span>
          <ul aria-labelledby="gateways-label">
            {lead.gateways.map((g) => <li>{g}</li>)}
          </ul>
        </div>
      </article>
      <div class="feature-list">
        {c.feat_rows.map((f) => (
          <article class="feature-row">
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            {f.href && <a class="link-plain" href={internal(f.href)}>{f.link}</a>}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
