---
import { C } from '../data/copy';
const lead = C.feat_lead;
---
<section class="features" id="features" data-section="features">
  <div class="wrap split">
    <div class="section-head split-head">
      <h2>{C.feat_title}</h2>
      <p>{C.feat_desc}</p>
    </div>
    <div class="split-body">
      <article class="feature-lead">
        <h3>{lead.title}</h3>
        <p>{lead.desc}</p>
        <div class="gateways">
          <span id="gateways-label">{lead.gateways_label}</span>
          <ul aria-labelledby="gateways-label">
            {lead.gateways.map((g) => <li>{g}</li>)}
          </ul>
        </div>
      </article>
      <div class="feature-list">
        {C.feat_rows.map((f) => (
          <article class="feature-row">
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
