---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import type { Copy, Locale } from '../data/copy';

interface Props {
	c: Copy;
	locale: Locale;
}
const { c, locale } = Astro.props;

const SITE_ID = 'd9701d64-9e78-4b73-9726-e4f41593b843';
const TRACKER = 'https://app.revklik.com/klikapa.js';
const ORIGIN = 'https://revklik.com';
const urls = { id: `${ORIGIN}/`, en: `${ORIGIN}/en/` };
const canonical = urls[locale];
const otherLocale = locale === 'en' ? 'id' : 'en';
const ogLocaleAlternate = otherLocale === 'en' ? 'en_US' : 'id_ID';

const prices = ['16000', '64000', '192000'];
const tiers = ['Micro', 'Starter', 'Growth'];
const jsonLdApp = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'RevKlik',
	url: canonical,
	inLanguage: locale,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Web',
	description: c.ld_description,
	offers: tiers.map((name, i) => ({ '@type': 'Offer', name, price: prices[i], priceCurrency: 'IDR', description: c.ld_offers[i] })),
	featureList: c.ld_features,
};
const jsonLdOrg = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'RevKlik',
	url: ORIGIN,
	logo: `${ORIGIN}/revklik.webp`,
	description: c.ld_org_description,
	parentOrganization: { '@type': 'Organization', name: 'Joyo Digitama', url: 'https://voltrus.id' },
};
const jsonLdFaq = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	inLanguage: locale,
	mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<!DOCTYPE html>
<html lang={c.lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{c.meta_title}</title>
<meta name="description" content={c.meta_description}>
<meta name="keywords" content={c.meta_keywords}>
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
<meta name="author" content="RevKlik">
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="id" href={urls.id}>
<link rel="alternate" hreflang="en" href={urls.en}>
<link rel="alternate" hreflang="x-default" href={urls.id}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/webp" sizes="32x32" href="/favicon.webp">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp">

<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={c.og_title}>
<meta property="og:description" content={c.og_description}>
<meta property="og:image" content="https://revklik.com/og-image.webp">
<meta property="og:site_name" content="RevKlik">
<meta property="og:locale" content={c.og_locale}>
<meta property="og:locale:alternate" content={ogLocaleAlternate}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={c.og_title}>
<meta name="twitter:description" content={c.og_description}>
<meta name="twitter:image" content="https://revklik.com/og-image.webp">

<script type="application/ld+json" set:html={JSON.stringify(jsonLdApp)} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLdFaq)} />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0e14">

<script is:inline>document.documentElement.classList.add('js')</script>

<script is:inline defer data-site-id={SITE_ID} src={TRACKER}></script>
<script is:inline defer src="/js/landing.js"></script>
</head>
<body>
<a class="skip-link" href="#konten">{c.skip}</a>
<SiteHeader c={c} locale={locale} />
<main id="konten">
	<slot />
</main>
<SiteFooter c={c} />
</body>
</html>
