---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/webp" href="/revklik.webp" />
		<meta name="theme-color" content="#1a1c24" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="RevKlik" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/logo.png", Astro.site)} />
		<meta name="twitter:card" content="summary" />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<a href="#konten" class="skip-link">Langsung ke konten</a>
		<Header />
		<main id="konten">
			<slot />
		</main>
		<Footer />
	</body>
</html>
